# Example env for Eurika (copy to `.env` — never commit real secrets).

# LLM — local Ollama is default (EURIKA_CHAT_PROVIDER=auto|ollama).
# Cloud / free-tier: same OPENAI_* vars (OpenAI-compatible HTTP). Pick a preset below
# or Models → API preset in Qt. Keys always go in OPENAI_API_KEY (never commit).

# EURIKA_CHAT_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# --- Free / cloud presets (uncomment ONE block + set key) ---
# Groq: https://console.groq.com/keys
# EURIKA_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b

# OpenRouter (many :free models): https://openrouter.ai/keys
# EURIKA_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openrouter/free

# Google Gemini (OpenAI-compat): https://aistudio.google.com/apikey
# EURIKA_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash

# Cerebras: https://cloud.cerebras.ai
# EURIKA_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.cerebras.ai/v1
# OPENAI_MODEL=llama-3.3-70b

# Mistral: https://console.mistral.ai
# EURIKA_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_MODEL=mistral-small-latest

# Binance (optional; local API probe — LLM+ML tandem, not a replacement)
# Prefer read-only / testnet keys until trading is enabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=0
# BINANCE_BASE_URL=   # optional override (default mainnet or testnet.vision)
# BINANCE_FUTURES_BASE_URL=  # optional USD-M fapi override (default fapi.binance.com / testnet.binancefuture.com)

# Remote trading bot (lbot / bbot on prodg) — read-only SSH status
# EURIKA_LBOT_SSH_HOST=prodg
# EURIKA_LBOT_REMOTE_DIR=~/lbot
# EURIKA_LBOT_SSH_TIMEOUT=15
# EURIKA_LBOT_PROBE=1

# Chat ML intent router (optional; YAML intents always win first)
# EURIKA_USE_ML_INTENT=1
# EURIKA_USE_VECTOR_INTENT=1   # Ollama nomic-embed-text fuzzy match

# Web search (optional)
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# Cursor SDK (optional: Models → Provider cursor)
# CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5
# CURSOR_OPTIMIZE_FOR=balanced
